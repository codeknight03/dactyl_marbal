#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <5>;


map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)                                             RC(0,15) RC(0,14) RC(0,13) RC(0,12) RC(0,11)  RC(0,10)  RC(0,9) 
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)                                             RC(1,15) RC(1,14) RC(1,13) RC(1,12) RC(1,11)  RC(1,10)  RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)  RC(2,8)          RC(2,17) RC(2,16) RC(2,15) RC(2,14) RC(2,13) RC(2,12) RC(2,11)  RC(2,10)  RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                  RC(3,8)          RC(3,17)                   RC(3,14) RC(3,13) RC(3,12) RC(3,11)  RC(3,10)  RC(3,9)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)         RC(4,5)  RC(4,7) RC(4,8)          RC(4,17) RC(4,16) RC(4,14)          RC(4,13) RC(4,12) RC(4,11)  RC(4,10)  RC(4,9)
                                                                
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Dactyl Manuform";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  // w h x y rot rx ry in 1/100 key units, same order as default_transform; measured from a photo of the board
            = <&key_physical_attrs 100 100 0 98 0 0 0>  // RC(0,0)
            , <&key_physical_attrs 100 100 75 69 0 0 0>  // RC(0,1)
            , <&key_physical_attrs 100 100 172 41 0 0 0>  // RC(0,2)
            , <&key_physical_attrs 100 100 268 18 0 0 0>  // RC(0,3)
            , <&key_physical_attrs 100 100 348 12 0 0 0>  // RC(0,4)
            , <&key_physical_attrs 100 100 433 1 0 0 0>  // RC(0,5)
            , <&key_physical_attrs 100 100 535 0 0 0 0>  // RC(0,6)
            , <&key_physical_attrs 100 100 1206 58 0 0 0>  // RC(0,15)
            , <&key_physical_attrs 100 100 1297 64 0 0 0>  // RC(0,14)
            , <&key_physical_attrs 100 100 1399 75 0 0 0>  // RC(0,13)
            , <&key_physical_attrs 100 100 1484 81 0 0 0>  // RC(0,12)
            , <&key_physical_attrs 100 100 1592 103 0 0 0>  // RC(0,11)
            , <&key_physical_attrs 100 100 1711 132 0 0 0>  // RC(0,10)
            , <&key_physical_attrs 100 100 1836 155 0 0 0>  // RC(0,9)
            , <&key_physical_attrs 100 100 0 189 0 0 0>  // RC(1,0)
            , <&key_physical_attrs 100 100 81 166 0 0 0>  // RC(1,1)
            , <&key_physical_attrs 100 100 200 120 0 0 0>  // RC(1,2)
            , <&key_physical_attrs 100 100 297 98 0 0 0>  // RC(1,3)
            , <&key_physical_attrs 100 100 376 98 0 0 0>  // RC(1,4)
            , <&key_physical_attrs 100 100 467 81 0 0 0>  // RC(1,5)
            , <&key_physical_attrs 100 100 564 98 0 0 0>  // RC(1,6)
            , <&key_physical_attrs 100 100 1177 166 0 0 0>  // RC(1,15)
            , <&key_physical_attrs 100 100 1268 149 0 0 0>  // RC(1,14)
            , <&key_physical_attrs 100 100 1365 166 0 0 0>  // RC(1,13)
            , <&key_physical_attrs 100 100 1450 166 0 0 0>  // RC(1,12)
            , <&key_physical_attrs 100 100 1569 189 0 0 0>  // RC(1,11)
            , <&key_physical_attrs 100 100 1689 228 0 0 0>  // RC(1,10)
            , <&key_physical_attrs 100 100 1808 257 0 0 0>  // RC(1,9)
            , <&key_physical_attrs 100 100 1 285 0 0 0>  // RC(2,0)
            , <&key_physical_attrs 100 100 98 262 0 0 0>  // RC(2,1)
            , <&key_physical_attrs 100 100 211 223 0 0 0>  // RC(2,2)
            , <&key_physical_attrs 100 100 314 200 0 0 0>  // RC(2,3)
            , <&key_physical_attrs 100 100 399 200 0 0 0>  // RC(2,4)
            , <&key_physical_attrs 100 100 490 183 0 0 0>  // RC(2,5)
            , <&key_physical_attrs 100 100 586 200 0 0 0>  // RC(2,6)
            , <&key_physical_attrs 100 100 632 365 0 0 0>  // RC(2,7)
            , <&key_physical_attrs 100 100 734 388 0 0 0>  // RC(2,8)
            , <&key_physical_attrs 100 100 1001 461 0 0 0>  // RC(2,17)
            , <&key_physical_attrs 100 100 1115 444 0 0 0>  // RC(2,16)
            , <&key_physical_attrs 100 100 1160 268 0 0 0>  // RC(2,15)
            , <&key_physical_attrs 100 100 1245 251 0 0 0>  // RC(2,14)
            , <&key_physical_attrs 100 100 1348 262 0 0 0>  // RC(2,13)
            , <&key_physical_attrs 100 100 1439 262 0 0 0>  // RC(2,12)
            , <&key_physical_attrs 100 100 1547 285 0 0 0>  // RC(2,11)
            , <&key_physical_attrs 100 100 1672 359 0 0 0>  // RC(2,10)
            , <&key_physical_attrs 100 100 1791 365 0 0 0>  // RC(2,9)
            , <&key_physical_attrs 100 100 1 382 0 0 0>  // RC(3,0)
            , <&key_physical_attrs 100 100 103 359 0 0 0>  // RC(3,1)
            , <&key_physical_attrs 100 100 217 319 0 0 0>  // RC(3,2)
            , <&key_physical_attrs 100 100 314 297 0 0 0>  // RC(3,3)
            , <&key_physical_attrs 100 100 399 297 0 0 0>  // RC(3,4)
            , <&key_physical_attrs 100 100 490 285 0 0 0>  // RC(3,5)
            , <&key_physical_attrs 100 100 723 615 0 0 0>  // RC(3,8)
            , <&key_physical_attrs 100 100 1030 689 0 0 0>  // RC(3,17)
            , <&key_physical_attrs 100 100 1245 353 0 0 0>  // RC(3,14)
            , <&key_physical_attrs 100 100 1348 365 0 0 0>  // RC(3,13)
            , <&key_physical_attrs 100 100 1439 359 0 0 0>  // RC(3,12)
            , <&key_physical_attrs 100 100 1547 393 0 0 0>  // RC(3,11)
            , <&key_physical_attrs 100 100 1672 461 0 0 0>  // RC(3,10)
            , <&key_physical_attrs 100 100 1797 461 0 0 0>  // RC(3,9)
            , <&key_physical_attrs 100 100 0 478 0 0 0>  // RC(4,0)
            , <&key_physical_attrs 100 100 98 467 0 0 0>  // RC(4,1)
            , <&key_physical_attrs 100 100 211 444 0 0 0>  // RC(4,2)
            , <&key_physical_attrs 100 100 308 410 0 0 0>  // RC(4,3)
            , <&key_physical_attrs 100 100 405 422 0 0 0>  // RC(4,4)
            , <&key_physical_attrs 100 200 512 451 0 0 0>  // RC(4,5)
            , <&key_physical_attrs 100 200 620 480 0 0 0>  // RC(4,7)
            , <&key_physical_attrs 100 100 734 501 0 0 0>  // RC(4,8)
            , <&key_physical_attrs 100 100 1018 581 0 0 0>  // RC(4,17)
            , <&key_physical_attrs 100 200 1126 559 0 0 0>  // RC(4,16)
            , <&key_physical_attrs 100 200 1240 559 0 0 0>  // RC(4,14)
            , <&key_physical_attrs 100 100 1365 490 0 0 0>  // RC(4,13)
            , <&key_physical_attrs 100 100 1461 478 0 0 0>  // RC(4,12)
            , <&key_physical_attrs 100 100 1564 530 0 0 0>  // RC(4,11)
            , <&key_physical_attrs 100 100 1689 564 0 0 0>  // RC(4,10)
            , <&key_physical_attrs 100 100 1808 564 0 0 0>  // RC(4,9)
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0 from the schematic file
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1 from the schematic file
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2 from the schematic file
            , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 3 from the schematic file
            , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 4 from the schematic file
            ;

    };
};
